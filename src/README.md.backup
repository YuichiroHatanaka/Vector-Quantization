## コードの構成
---
### P5Header.c
- バイナリ形式のPGMファイルのヘッダを読み取る関数
---
### 入力
```c
// 6行目
char rawMap[]	// PGMファイルのパス
```
### 出力
```c
// 6行目
Header *data　
```
```c
// ヘッダファイルに記述
typedef struct {
    int width;	// 画像の幅
    int height;	// 画像の高さ
    int start;	// 画像データが始まる位置
} Header;
```
---
### 変数の一覧
```c
// 6~13行目
#define MAX_LINE_LENGTH 256					//文字列の最大長

FILE *rawMap_fp;                        		//圧縮前の地図のファイルポイント
char map_data[MAX_LINE_LENGTH];                 //1行のデータを格納する配列
char correct_format[MAX_LINE_LENGTH] = "P5\n";  //P5形式であることを確認
char pixel_value[] = "255\n";                   //画素値の範囲が0~255であることを確認
int comment_length = 0;                         //コメントの長さ（初期値は0）
```
---
### ファイルが開くかを確認
```c
// 15~22行目
// マップファイルが開く
rawMap_fp = fopen(rawMap, "r");

//ファイルが開かない場合はエラーを出力
if (rawMap_fp == NULL) {
	perror("## %sを開くことができません\n", rawMap);
	return 1;
}
```
### ファイルを閉じる
```
// 63~64行目
// 開いたファイルを閉じる
fclose(rawMap_fp);
```
---
### ファイルがバイナリ形式のPGMファイルであるかを確認
```c
// 25~32行目
//1行目の文字列を入手   
fgets(map_data, MAX_LINE_LENGTH, rawMap_fp);

//P5形式でないならエラーを出力
if(strcmp(map_data, correct_format) != 0){
	perror("# 入力ファイルの形式が違違います\n");
	return 1;
}
```
---
### 幅と高さを取得
- ２行目にコメントがある場合はスキップ

```c
// 34~48行目
//圧縮前の地図の幅と高さのデータを取得
for(;;){
// データを取得	
	fgets(map_data, MAX_LINE_LENGTH, rawMap_fp);
	
//コメントが存在する場合は無視
	if(map_data[0] == '#'){
		comment_length += strlen(map_data);

//幅と高さのデータを取得
	}else{
		sscanf(map_data, "%d %d", &data->width, &data->height);
		break;
	}
}

```
---
### 画素値が0~255であるか確認
```c
// 50~58行目
// 画素値の範囲を取得
fgets(map_data, MAX_LINE_LENGTH, rawMap_fp);

// 画素値が0~255出ない場合はエラーを出力
if(strcmp(map_data, pixel_value) != 0){
	perror("画素値の範囲が違います\n");
	fclose(rawMap_fp);
	return 1;
}
```
### 画像データの先頭位置を入手
```c
// 60~61行目
// 画像データの先頭位置を取得
data->start = ftell(rawMap_fp);
```

